<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Backend</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ML.NET: K-Means clustering for incident hotspot detection -->
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
    <!-- OpenAPI/Swagger UI served at /api/swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <!-- Reads the published dependency graph from S3 (serverless stack) -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Synthetic sample graph, used when no published graph is configured -->
    <Content Update="Data\ci-graph.sample.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
